---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { navigation } from '../../data/navigation';
export async function getStaticPaths() { return (await getCollection('docs')).map((entry) => ({ params: { slug: entry.id }, props: { entry } })); }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const tableOfContents = headings.filter((heading) => heading.depth >= 2);
const current = navigation.flatMap((group) => group.items).find((item) => item.slug === entry.id);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="docs-shell">
    <header class="docs-header"><a class="brand" href={base}><span class="brand-mark">A</span>Atlas <em>Wiki</em></a><a href={base}>返回首页 ↗</a></header>
    <div class="docs-layout"><aside>{navigation.map((group) => <div class="nav-group"><a class="nav-group-title" href={`${base}/docs/${group.cardSlug}`}>{group.title}</a>{group.items.map((item) => <a class:list={{active: item.slug === entry.id}} href={`${base}/docs/${item.slug}`}>{item.label}</a>)}</div>)}</aside><article><div class="crumb">{entry.data.section} / {current?.label ?? entry.data.title}</div><h1>{entry.data.title}</h1>{entry.data.description && <p class="intro">{entry.data.description}</p>}<Content /></article>{tableOfContents.length > 0 && <nav class="page-toc" aria-label="本页目录"><p>本页目录</p><ol>{tableOfContents.map((heading) => <li class:list={{nested: heading.depth > 2}}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav>}</div>
  </div>
</BaseLayout>
<style is:global>
.docs-shell{max-width:1120px;margin:auto;padding:0 42px}.docs-header{height:92px;border-bottom:1px solid #dfe3da;display:flex;align-items:center;justify-content:space-between}.docs-header a{color:#777b73;text-decoration:none;font-size:13px}.docs-header .brand{color:#20221f;font-weight:700;font-size:17px;display:flex;align-items:center;gap:10px}.docs-header em{font-style:normal;color:#777b73;font-weight:400}.docs-layout{display:grid;grid-template-columns:180px minmax(0,1fr) 150px;gap:35px;padding:65px 0}.docs-layout aside{border-right:1px solid #dfe3da;padding-right:25px}.nav-group{margin-bottom:30px}.nav-group .nav-group-title{font:10px 'DM Mono',monospace;color:#d76742;text-transform:uppercase;letter-spacing:.1em;display:block;margin-bottom:13px;padding:0}.nav-group a{display:block;padding:8px 10px;color:#777b73;text-decoration:none;font-size:13px;border-radius:3px}.nav-group a.active,.nav-group a:hover{color:#20221f;background:#fff}.nav-group .nav-group-title:hover{color:#20221f;background:transparent}.docs-layout article{min-width:0}.crumb{font:11px 'DM Mono',monospace;color:#d76742;margin-bottom:28px}.docs-layout h1{font-size:52px;letter-spacing:-.05em;margin:0 0 18px}.intro{font-size:18px;color:#777b73;line-height:1.7;margin-bottom:45px}.docs-layout article h2{font-size:25px;margin:42px 0 15px}.docs-layout article p,.docs-layout article li{color:#555b53;line-height:1.85}.docs-layout article img{max-width:100%;height:auto}.docs-layout article code{background:#eceee8;padding:2px 5px;border-radius:3px;font-family:'DM Mono',monospace;font-size:.85em}.docs-layout article pre{background:#20221f;color:#f8f8f3;padding:20px;overflow:auto;border-radius:4px;font:13px/1.7 'DM Mono',monospace}.page-toc{position:sticky;top:28px;align-self:start;border-left:1px solid #dfe3da;padding-left:18px}.page-toc p{margin:0 0 13px;color:#d76742;font:10px 'DM Mono',monospace;letter-spacing:.1em}.page-toc ol{list-style:none;margin:0;padding:0}.page-toc li{margin:0 0 10px}.page-toc li.nested{padding-left:10px}.page-toc a{color:#777b73;text-decoration:none;font-size:12px;line-height:1.45}.page-toc a:hover{color:#20221f}.brand-mark{display:grid;place-items:center;width:30px;height:30px;background:#20221f;color:#f8f8f3;border-radius:8px;font-family:Georgia;font-size:19px}@media(max-width:900px){.docs-layout{grid-template-columns:180px minmax(0,1fr);gap:55px}.page-toc{display:none}}@media(max-width:700px){.docs-shell{padding:0 20px}.docs-layout{display:block;padding-top:35px}.docs-layout aside{border:0;padding:0;display:flex;gap:10px;overflow:auto;margin-bottom:45px}.nav-group{min-width:145px}.docs-layout h1{font-size:40px}}
</style>
