---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { navigation } from '../data/navigation';

const docs = (await getCollection('docs')).filter((doc) => !doc.data.draft);
const featured = docs.find((doc) => doc.id === 'welcome');
const base = import.meta.env.BASE_URL;
---
<BaseLayout />
<main class="home-shell">
  <nav class="topbar">
    <a class="brand" href={base}><span class="brand-mark">A</span><span>Atlas <em>Wiki</em></span></a>
    <div class="top-links"><a href="#docs">文档</a><a href={`${base}docs/welcome`}>关于</a><a class="github" href="https://github.com" target="_blank">GitHub ↗</a></div>
  </nav>
  <section class="hero">
    <p class="eyebrow">A LIVING KNOWLEDGE BASE</p>
    <h1>把知识，变成<br /><i>可以抵达的地方。</i></h1>
    <p class="lead">Atlas 是团队共享的第二大脑。用清晰的结构记录决策、沉淀经验，让每一次探索都有迹可循。</p>
    <a class="primary-button" href={`${base}docs/welcome`}>开始阅读 <span>→</span></a>
  </section>
  <section class="directory" id="docs">
    <div class="section-heading"><div><p class="eyebrow">EXPLORE THE KNOWLEDGE</p><h2>从这里开始</h2></div><span class="doc-count">{docs.length} 篇文章</span></div>
    <div class="cards">
      {navigation.map((group) => <div class="card"><span class="card-index">0{navigation.indexOf(group) + 1}</span><h3>{group.title}</h3><ul>{group.items.map((item) => <li><a href={`${base}docs/${item.slug}`}>{item.label}<span>↗</span></a></li>)}</ul></div>)}
    </div>
  </section>
  <footer><span>© 2026 Atlas Wiki</span><span>Built with Astro · Made for curious teams</span></footer>
</main>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,600&display=swap');
:root{--ink:#20221f;--muted:#777b73;--line:#dfe3da;--accent:#d76742;--paper:#f8f8f3}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:'DM Sans',sans-serif}.home-shell{max-width:1120px;margin:auto;padding:0 42px}.topbar{height:92px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:11px;color:var(--ink);font-weight:700;font-size:17px;text-decoration:none}.brand em{font-style:normal;color:var(--muted);font-weight:400}.brand-mark{display:grid;place-items:center;width:30px;height:30px;background:var(--ink);color:var(--paper);border-radius:8px;font-family:Georgia;font-size:19px}.top-links{display:flex;gap:30px;align-items:center;font-size:13px}.top-links a{color:var(--muted);text-decoration:none}.top-links a:hover,.cards a:hover{color:var(--accent)}.github{border:1px solid var(--line);padding:10px 14px;border-radius:5px}.hero{padding:110px 0 120px;max-width:770px}.eyebrow{font:500 10px 'DM Mono',monospace;letter-spacing:.14em;color:var(--accent);margin:0 0 26px}.hero h1{font-size:clamp(50px,7vw,82px);line-height:1.04;letter-spacing:-.06em;margin:0 0 28px;font-weight:600}.hero h1 i{font-family:'Playfair Display',serif;font-weight:600;color:var(--accent)}.lead{font-size:17px;line-height:1.8;color:var(--muted);max-width:530px;margin-bottom:37px}.primary-button{background:var(--ink);color:#fff;padding:15px 21px;display:inline-flex;gap:25px;text-decoration:none;border-radius:4px;font-size:13px}.primary-button:hover{background:var(--accent)}.directory{border-top:1px solid var(--line);padding:65px 0 100px}.section-heading{display:flex;align-items:end;justify-content:space-between;margin-bottom:35px}.section-heading h2{font-size:30px;letter-spacing:-.04em;margin:0}.section-heading .eyebrow{margin-bottom:14px}.doc-count{font:11px 'DM Mono',monospace;color:var(--muted)}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{background:#fff;border:1px solid var(--line);padding:25px;min-height:215px;transition:transform .2s}.card:hover{transform:translateY(-3px)}.card-index{font:11px 'DM Mono',monospace;color:var(--accent)}.card h3{font-size:19px;margin:35px 0 20px}.card ul{list-style:none;padding:0;margin:0}.card li{border-top:1px solid var(--line);padding:10px 0}.card a{color:var(--muted);font-size:13px;text-decoration:none;display:flex;justify-content:space-between}.card a span{color:var(--accent)}footer{border-top:1px solid var(--line);padding:24px 0 35px;display:flex;justify-content:space-between;color:var(--muted);font:10px 'DM Mono',monospace}@media(max-width:700px){.home-shell{padding:0 20px}.top-links a:not(.github){display:none}.hero{padding:75px 0 90px}.cards{grid-template-columns:1fr}.section-heading{align-items:start;gap:20px;flex-direction:column}footer{gap:15px;flex-direction:column}}
</style>
